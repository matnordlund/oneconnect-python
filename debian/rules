#!/usr/bin/make -f

export PYBUILD_NAME=oneconnect-linux

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	# Install Python payload directly into the oneconnect binary package dir.
	dh_auto_install --destdir=debian/oneconnect
	# Some pyproject installer environments place files under /usr/local in destdir.
	# Normalize to /usr so runtime paths are consistent.
	if [ -d debian/oneconnect/usr/local/bin ]; then \
		mkdir -p debian/oneconnect/usr/bin; \
		mv debian/oneconnect/usr/local/bin/* debian/oneconnect/usr/bin/ || true; \
	fi
	if [ -d debian/oneconnect/usr/local/lib ]; then \
		mkdir -p debian/oneconnect/usr/lib; \
		mv debian/oneconnect/usr/local/lib/* debian/oneconnect/usr/lib/ || true; \
	fi
	if [ -d debian/oneconnect/usr/local ]; then \
		rmdir --ignore-fail-on-non-empty debian/oneconnect/usr/local/bin debian/oneconnect/usr/local/lib debian/oneconnect/usr/local || true; \
	fi
